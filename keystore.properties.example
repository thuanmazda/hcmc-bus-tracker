# ==============================================================================
# HCMC Bus Tracker - Release Keystore Configuration Template
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép tệp này thành 'keystore.properties' tại thư mục gốc của dự án.
# 2. Điền đường dẫn và thông tin keystore của bạn vào các trường bên dưới.
# 3. TUYỆT ĐỐI KHÔNG commit tệp 'keystore.properties' lên Git (đã được cấu hình trong .gitignore).
#
# INSTRUCTIONS:
# 1. Copy this file to 'keystore.properties' in the project root directory.
# 2. Fill in your release keystore path and passwords below.
# 3. NEVER commit 'keystore.properties' to version control (gitignored).
# ==============================================================================

# Đường dẫn đến tệp keystore (đường dẫn tương đối từ thư mục gốc hoặc đường dẫn tuyệt đối)
# Ví dụ: release-keystore/hcmc-bus-tracker-release.jks hoặc C:/secure/hcmc-bus-tracker-release.jks
storeFile=release-keystore/hcmc-bus-tracker-release.jks

# Mật khẩu bảo vệ tệp keystore
storePassword=YOUR_KEYSTORE_PASSWORD_HERE

# Tên định danh (alias) của khóa ký phát hành trong keystore
keyAlias=hcmc_bus_release_key

# Mật khẩu của private key
keyPassword=YOUR_KEY_PASSWORD_HERE
